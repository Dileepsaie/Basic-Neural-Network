# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Azure Authentication
AZURE_TENANT_ID=your_tenant_id
AZURE_CLIENT_ID=your_client_id
AZURE_CLIENT_SECRET=your_client_secret

# Azure Blob Storage
AZURE_STORAGE_ACCOUNT_NAME=your_storage_account
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...

# Azure SQL Database
AZURE_SQL_SERVER=your_server.database.windows.net
AZURE_SQL_DATABASE=your_database
AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:...

# Azure Synapse Analytics
AZURE_SYNAPSE_WORKSPACE=your_synapse_workspace
AZURE_SYNAPSE_SQL_POOL=your_sql_pool
AZURE_SYNAPSE_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:...

# PowerApps Dataverse
DATAVERSE_ENVIRONMENT_URL=https://your_environment.crm.dynamics.com
DATAVERSE_CLIENT_ID=your_dataverse_app_id
DATAVERSE_CLIENT_SECRET=your_dataverse_app_secret

# Azure Key Vault (optional - for secure secret management)
AZURE_KEY_VAULT_URL=https://your_keyvault.vault.azure.net/
